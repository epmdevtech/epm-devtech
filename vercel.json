  ],
  "headers": [
    {
      "source": "/og-odontologia.jpg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!og-odontologia\\.jpg).*)",
      "destination": "/index.html"
    }
  ]
}
