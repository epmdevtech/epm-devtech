{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/odontologia-demo",
      "destination": "https://dentistry-demo.elessandrodev.workers.dev"
    },
    {
      "source": "/odontologia-demo/:path*",
      "destination": "https://dentistry-demo.elessandrodev.workers.dev/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/odontologia-demo/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
