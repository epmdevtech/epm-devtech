    },
    {
      "source": "/setores",
      "destination": "/experience",
      "permanent": true
    },
    {
      "source": "/autoridade",
      "destination": "/experience",
      "permanent": true
    },
    {
      "source": "/diferenciais",
      "destination": "/engineering",
