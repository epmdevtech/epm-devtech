# EmailJS — https://www.emailjs.com/
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env com valores reais.
#
# Como configurar:
# 1. Crie uma conta em https://emailjs.com
# 2. Adicione um Email Service (Gmail, Outlook, etc.)
# 3. Crie um Email Template com as variáveis:
#    {{from_name}}, {{from_email}}, {{phone}}, {{project_type}}, {{message}}
# 4. Preencha os valores abaixo

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
